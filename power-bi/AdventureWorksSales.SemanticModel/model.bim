            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Snapshot = Json.Document(Binary.Decompress(Binary.FromText(\"i45WMjIwNFKK1QEzjJViYwE=\", BinaryEncoding.Base64), Compression.Deflate)),",
                "    Rows = Table.FromRows(Snapshot, type table [#\"Year\" = nullable text])",
