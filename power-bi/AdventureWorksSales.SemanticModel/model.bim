      {
        "name": "Channel Results",
        "columns": [
          {
            "name": "Year",
            "dataType": "string",
            "sourceColumn": "Year",
            "summarizeBy": "none"
          },
          {
            "name": "Channel",
            "dataType": "string",
            "sourceColumn": "Channel",
            "summarizeBy": "none"
          },
          {
            "name": "Sales USD",
            "dataType": "double",
            "sourceColumn": "Sales USD",
            "summarizeBy": "none"
          },
          {
            "name": "Profit USD",
            "dataType": "double",
            "sourceColumn": "Profit USD",
            "summarizeBy": "none"
          },
          {
            "name": "Orders",
            "dataType": "int64",
            "sourceColumn": "Orders",
            "summarizeBy": "none"
          },
          {
            "name": "Units",
            "dataType": "int64",
            "sourceColumn": "Units",
            "summarizeBy": "none"
          }
        ],
        "measures": [
          {
            "name": "Sales",
            "expression": "SUM('Channel Results'[Sales USD])",
            "formatString": "$#,0.00;($#,0.00)"
          },
          {
            "name": "Gross profit",
            "expression": "SUM('Channel Results'[Profit USD])",
            "formatString": "$#,0.00;($#,0.00)"
          },
          {
            "name": "Gross margin",
            "expression": "DIVIDE([Gross profit], [Sales])",
            "formatString": "0.00%"
          },
          {
            "name": "Order count",
            "expression": "SUM('Channel Results'[Orders])",
            "formatString": "#,0"
          },
          {
            "name": "Units sold",
            "expression": "SUM('Channel Results'[Units])",
            "formatString": "#,0"
          },
          {
            "name": "Average order value",
            "expression": "DIVIDE([Sales], [Order count])",
            "formatString": "$#,0.00;($#,0.00)"
          }
        ],
        "partitions": [
          {
            "name": "Channel Results",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
